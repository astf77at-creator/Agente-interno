# Copia este archivo a .env y rellena tus valores. NO subas .env a git.

# --- WhatsApp Cloud API (Meta) ---
WA_TOKEN=tu_token_permanente_de_meta
WA_PHONE_NUMBER_ID=123456789012345
WA_VERIFY_TOKEN=chabelita
WA_API_VERSION=v21.0

# --- Odoo ---
ODOO_URL=https://miempresa.odoo.com
ODOO_DB=miempresa
ODOO_USERNAME=usuario@miempresa.com
ODOO_PASSWORD=tu_api_key_o_password_de_odoo

# --- Anthropic (Claude) ---
ANTHROPIC_API_KEY=sk-ant-...
ANTHROPIC_MODEL=claude-sonnet-4-6
ANTHROPIC_MAX_TOKENS=1024

# --- Agente ---
WAKE_WORD=chabelita
# Números de TRABAJADORES (con código de país, sin +), separados por comas.
WORKER_NUMBERS=5215512345678,5215587654321
SESSION_TTL_MINUTES=15
BRAND_NAME=YOOHOO
